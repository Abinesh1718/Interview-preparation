SELECT name,salary , role
  CASE 
  WHEN salary >= 60000 THEN 'High'
  WHEN salary BETWEEN 50000 AND 55000 THEN 'Medium'
  ELSE 'LOW'
  END AS salary_level
  FROM employee


  
SELECT name, salary, role,
  CASE role
    WHEN 'Manager' THEN 'Team Lead'
    WHEN 'Developer' THEN 'Engineer'
    ELSE 'Support Staff'
  END AS custom_title
FROM employee
